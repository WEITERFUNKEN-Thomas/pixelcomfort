<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      cv_enabled liegt im "system"-Namespace. Zum Schreiben ueber ContentResolver
      (Settings.System) wird der WRITE_SETTINGS-AppOp benoetigt; WRITE_SECURE_SETTINGS
      wird zusaetzlich per Shizuku (pm grant) erteilt und deckt Secure/Global ab.
      Beide werden einmalig per Shizuku freigeschaltet (siehe MainActivity).
    -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PixelComfort">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.PixelComfort"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Bedienungshilfe: erkennt das Oeffnen/Schliessen der Ziel-Apps -->
        <service
            android:name=".ComfortAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!--
          Schnelleinstellungs-Kachel zum manuellen Umschalten. Der System-UI bindet
          den Dienst, deshalb exported + BIND_QUICK_SETTINGS_TILE.
        -->
        <service
            android:name=".ComfortTileService"
            android:exported="true"
            android:icon="@drawable/ic_qs_comfort"
            android:label="@string/qs_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Shizuku -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

    </application>

</manifest>
