<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup/Geraetewechsel ab API 31. Der Laufzeit-Zustand (suppressed/saved_value)
   gehoert nur zu diesem Geraet und wird weder gesichert noch uebertragen.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="pixelcomfort_state.xml" />
        <exclude domain="file" path="datastore/aod_rules.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="pixelcomfort_state.xml" />
        <exclude domain="file" path="datastore/aod_rules.json" />
    </device-transfer>
</data-extraction-rules>
